# Copy to .env.local and fill in. Never commit real values.
# Only PUBLIC values belong here: everything NEXT_PUBLIC_* ends up in the browser bundle.
# The Supabase service_role key must NEVER be used in this project.

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (or legacy anon) key. Safe for the browser; RLS + RPC grants protect the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Web3Forms access key for the contact form (web3forms.com, free).
NEXT_PUBLIC_WEB3FORMS_KEY=
# false = waitlist / play buttons; true = store download badges (app launched).
NEXT_PUBLIC_LAUNCHED=false
# Production origin without trailing slash; used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://medi-bela.example

# LOCAL ONLY, for scripts/db.sh (migrations + SQL tests). Never NEXT_PUBLIC_, never on the host.
# Supabase → Project Settings → Database → Connection string → Session pooler.
SUPABASE_DB_URL=
